rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Helper: UserProfileDoc
    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 100 &&
             data.college is string &&
             data.college.size() >= 1 &&
             data.college.size() <= 150 &&
             data.board is string &&
             data.board in ['UBTER', 'BTEUP', 'HSBTE', 'MSBTE'] &&
             data.branch is string &&
             data.branch in ['CIVIL', 'MECHANICAL', 'ELECTRICAL', 'CSE'] &&
             data.semester is int &&
             data.semester >= 1 &&
             data.semester <= 6 &&
             data.bookmarkedIds is list &&
             data.bookmarkedIds.size() <= 50 &&
             (data.bookmarkedIds.size() == 0 || (data.bookmarkedIds[0] is string && data.bookmarkedIds[0].size() <= 64)) &&
             data.completedTopics is list &&
             data.completedTopics.size() <= 100 &&
             (data.completedTopics.size() == 0 || (data.completedTopics[0] is string && data.completedTopics[0].size() <= 150)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    // Validation Helper: CloudStudyResource
    function isValidCloudResource(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.subjectId is string &&
             data.subjectId.size() >= 1 &&
             data.subjectId.size() <= 64 &&
             data.subjectName is string &&
             data.subjectName.size() >= 1 &&
             data.subjectName.size() <= 120 &&
             data.title is string &&
             data.title.size() >= 4 &&
             data.title.size() <= 200 &&
             data.unit is int &&
             data.unit >= 1 &&
             data.unit <= 10 &&
             data.type is string &&
             data.type in ['NOTES', 'PRACTICALS', 'PYQS', 'VIVA'] &&
             data.documentUrl is string &&
             data.documentUrl.size() >= 8 &&
             data.documentUrl.size() <= 500 &&
             data.source is string &&
             data.source.size() >= 1 &&
             data.source.size() <= 150 &&
             data.reviewStatus is string &&
             data.reviewStatus in ['FACULTY_VERIFIED', 'PEER_REVIEWED', 'UNDER_REVIEW'] &&
             data.uploadedAt is string &&
             data.uploadedAt.size() >= 1 &&
             data.uploadedAt.size() <= 40 &&
             data.semester is int &&
             data.semester >= 1 &&
             data.semester <= 6 &&
             data.description is string &&
             data.description.size() >= 1 &&
             data.description.size() <= 500 &&
             data.topicsCovered is list &&
             data.topicsCovered.size() <= 15 &&
             (data.topicsCovered.size() == 0 || (data.topicsCovered[0] is string && data.topicsCovered[0].size() <= 150)) &&
             data.pageCountOrLength is string &&
             data.pageCountOrLength.size() >= 1 &&
             data.pageCountOrLength.size() <= 60 &&
             data.fileFormat is string &&
             data.fileFormat.size() >= 1 &&
             data.fileFormat.size() <= 60 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    // Collection 1: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    request.auth.uid == userId;

      allow list: if isSignedIn() &&
                     request.auth.uid == userId &&
                     existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'name', 'college', 'board', 'branch',
                         'semester', 'bookmarkedIds', 'completedTopics',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'name', 'college', 'board', 'branch',
                         'semester', 'bookmarkedIds', 'completedTopics',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'name', 'college', 'board', 'branch', 'semester',
                         'bookmarkedIds', 'completedTopics', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId;

      // Subcollection 2: /users/{userId}/resources/{resourceId}
      match /resources/{resourceId} {
        allow get: if isSignedIn() &&
                      isValidId(userId) &&
                      isValidId(resourceId) &&
                      request.auth.uid == userId &&
                      existing().userId == request.auth.uid;

        allow list: if isSignedIn() &&
                       request.auth.uid == userId &&
                       existing().userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(resourceId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'subjectId', 'subjectName', 'title', 'unit',
                           'type', 'documentUrl', 'source', 'reviewStatus', 'uploadedAt',
                           'semester', 'description', 'topicsCovered', 'pageCountOrLength',
                           'fileFormat', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'subjectId', 'subjectName', 'title', 'unit',
                           'type', 'documentUrl', 'source', 'reviewStatus', 'uploadedAt',
                           'semester', 'description', 'topicsCovered', 'pageCountOrLength',
                           'fileFormat', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidCloudResource(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(resourceId) &&
                         request.auth.uid == userId &&
                         isValidCloudResource(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'unit', 'type', 'documentUrl', 'source',
                           'reviewStatus', 'description', 'topicsCovered',
                           'pageCountOrLength', 'fileFormat', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(resourceId) &&
                         request.auth.uid == userId &&
                         existing().userId == request.auth.uid;
      }
    }
  }
}
