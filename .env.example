# ============================================================================
# PolyNotes Backend Proxy Environment Configuration (.env.example)
# ============================================================================
# SECURITY ARCHITECTURE:
# - ZERO API keys are ever compiled or hardcoded into the Android APK.
# - The Android client communicates exclusively with the lightweight Backend
#   Proxy (/api/v1/...) without any client-side keys.
# - External API keys below are read ONLY by the server-side Node.js Backend
#   Proxy (backend/proxy-server.js and api/proxy.js) via process.env.
# ============================================================================

# Server-side only API key used by the backend proxy when forwarding upstream requests:
# EXTERNAL_API_KEY=your_server_side_api_key_here

# Port for running the standalone lightweight backend proxy server locally:
PORT=8787
